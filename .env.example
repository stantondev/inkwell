# ──────────────────────────────────────────────────────────────
# Inkwell self-hosted settings
#
#   cp .env.example .env
#
# Only the first three are required. See SELF_HOSTING.md.
# ──────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────

# Your server's domain, without https://. DNS must point here.
# This is part of every member's fediverse address (@name@DOMAIN) and
# CAN'T BE CHANGED once people have signed up. Use DOMAIN=localhost to try
# Inkwell on your own computer.
DOMAIN=

# Your email address. Signing in with it makes you the admin, and it's where
# members' questions and appeals go (set CONTACT_EMAIL to use another address).
# More admins: separate addresses with commas.
ADMIN_EMAIL=

# A long random secret. Generate one with:  openssl rand -base64 64
SECRET_KEY_BASE=

# ── Recommended ──────────────────────────────────────────────

# What your server is called (shown in page titles, emails and on the
# fediverse). Defaults to the domain.
INSTANCE_NAME=

# Database password (used by both the database and the API)
POSTGRES_PASSWORD=inkwell

# ── Email ─────────────────────────────────────────────────────
# Inkwell signs people in with emailed links, so real use needs email.
# Until it's set up, sign-in links are written to the API log instead:
#   docker compose -f docker-compose.selfhosted.yml logs api | grep "magic link"
# If both SMTP and Resend are set, SMTP is used.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# "true" for port 465 (implicit TLS); leave false for 587 (STARTTLS)
SMTP_SSL=false
# "false" for a relay that needs no login, e.g. a local Postfix
SMTP_AUTH=

# Or Resend instead of SMTP
RESEND_API_KEY=

# Who emails come from. Defaults to "INSTANCE_NAME <noreply@DOMAIN>";
# it must be an address your mail provider lets you send as.
FROM_EMAIL=

# Where members' questions go, if not ADMIN_EMAIL
CONTACT_EMAIL=

# ── Your policies ─────────────────────────────────────────────
# Put terms.md and privacy.md in the legal/ folder (see legal/README.md),
# or link to where they live:
TERMS_URL=
PRIVACY_URL=

# ── Optional ──────────────────────────────────────────────────

# Full-text search. Start with --profile search, then set:
#   MEILI_MASTER_KEY=<a long random string>
#   MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=
MEILI_URL=

# Browser push notifications. Generate a key pair with:
#   docker compose -f docker-compose.selfhosted.yml exec api bin/inkwell eval 'IO.inspect(WebPushEncryption.generate_vapid_key())'
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Translation (DeepL; the free tier allows 500K characters a month)
DEEPL_API_KEY=

# Slack incoming webhook for admin notices
SLACK_WEBHOOK_URL=

# Post by Email (needs a Postmark inbound server; see SELF_HOSTING.md)
POSTMARK_INBOUND_TOKEN=
POST_EMAIL_DOMAIN=

# Stay on one build instead of the newest: the full commit id of a push to
# main (each is published under that tag). "latest" is the newest tested build.
INKWELL_VERSION=latest
