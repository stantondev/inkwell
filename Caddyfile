# ──────────────────────────────────────────────────────────────
# Inkwell — Caddy reverse proxy
#
# Serves https://DOMAIN (set in .env) with a certificate from Let's Encrypt,
# fetched automatically. DOMAIN must already point at this server and ports
# 80 and 443 must be open. With DOMAIN=localhost, Caddy uses its own local
# certificate instead: your browser will warn once, which is fine for trying
# Inkwell out.
#
# Everything goes to the web app, which talks to the API inside Docker.
# ──────────────────────────────────────────────────────────────

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}
